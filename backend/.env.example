# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=3000

# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the connection string
# Replace <username>, <password> and add the DB name (studyflow) before the "?"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studyflow?retryWrites=true&w=majority

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend URLs allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
